---
import BaseLayout from "../layouts/BaseLayout.astro";
import { MEMBERS, TOTAL_DAYS } from "../data/members";
import {
  CALENDAR_START_DAY,
  CALENDAR_START_MONTH,
  CELEBRATION_DAY,
  CELEBRATION_MONTH,
} from "../utils/calendar";

const visibleMembers = MEMBERS.filter((member) => member.id !== "pierrick");
---

<BaseLayout
  title="Calendrier de l'avent"
  description="Chaque membre de la famille a son calendrier de surprises qui se débloquent jour après jour."
>
  <header>
    <div class="brand">
      <div class="crest">🎁</div>
      <div>
        <h1>Calendrier de l'avent <br />de la Pokéfamily</h1>
      </div>
    </div>
    <div class="badge">19 novembre → 12 décembre</div>
  </header>

  <p class="intro">
    Chaque membre de la famille a son calendrier personnel. Clique sur ton nom
    pour voir les surprises qui se débloquent jour après jour.
  </p>

  <div
    class="hero"
    data-total-days={TOTAL_DAYS}
    data-start-month={CALENDAR_START_MONTH}
    data-start-day={CALENDAR_START_DAY}
    data-celebration-month={CELEBRATION_MONTH}
    data-celebration-day={CELEBRATION_DAY}
  >
    <h2 class="countdown" data-countdown>Noël approche à grand pas !</h2>
    <p class="sub-countdown" data-next-countdown>
      Chargement du prochain paquet…
    </p>
  </div>

  <div class="card-grid">
    {
      visibleMembers.map((member) => (
        <a class="card" href={`/${member.id}`} data-member={member.id}>
          <h2>{member.name}</h2>
          <span class="member-name-outline">{member.name}</span>
          <p class="muted">Tous les jours une surprise !</p>
          <span class="btn card-btn">
            Voir le calendrier de l'avent
            <span aria-hidden="true">↗︎</span>
          </span>
        </a>
      ))
    }
  </div>

  <script>
    const search = new URLSearchParams(window.location.search);
    const debug = search.get("debugDate");

    if (debug) {
      document.querySelectorAll("a[data-member]").forEach((link) => {
        const target = new URL(link.href, window.location.origin);
        target.searchParams.set("debugDate", debug);
        link.href = `${target.pathname}${target.search}`;
      });
    }

    function parseDebugDate(value) {
      if (!value) return null;
      const parts = value.split("-").map((n) => Number(n));
      if (parts.length !== 3 || parts.some(Number.isNaN)) return null;
      const [year, month, day] = parts;
      const nowTime = new Date();
      return new Date(
        year,
        month - 1,
        day,
        nowTime.getHours(),
        nowTime.getMinutes(),
        nowTime.getSeconds(),
        nowTime.getMilliseconds(),
      );
    }

    const debugDate = parseDebugDate(debug);
    const baseDate = debugDate ?? new Date();
    const seasonYear = baseDate.getFullYear();
    const baseMs = baseDate.getTime();
    const startReal = Date.now();
    const useDebug = !!debugDate;
    const pad2 = (n) => String(n).padStart(2, "0");
    const getNowMs = () =>
      useDebug ? baseMs + (Date.now() - startReal) : Date.now();
    const totalDays = Number(
      document.querySelector("[data-total-days]")?.dataset.totalDays || 24,
    );
    const hero = document.querySelector("[data-total-days]");
    const startMonth = Number(hero?.dataset.startMonth ?? 10);
    const startDay = Number(hero?.dataset.startDay ?? 19);
    const celebrationMonth = Number(hero?.dataset.celebrationMonth ?? 11);
    const celebrationDay = Number(hero?.dataset.celebrationDay ?? 12);
    const start = new Date(seasonYear, startMonth, startDay);
    const end = new Date(
      seasonYear,
      celebrationMonth,
      celebrationDay,
      23,
      59,
      59,
      999,
    );
    const dateForDay = (day) =>
      new Date(seasonYear, startMonth, startDay + day - 1);

    const countdownNode = document.querySelector("[data-countdown]");
    if (countdownNode) {
      const target = new Date(
        seasonYear,
        celebrationMonth,
        celebrationDay,
        0,
        0,
        0,
        0,
      ).getTime();
      const fmt = (value, unit) =>
        `<span class="count-value">${value}</span><span class="count-unit">${unit}</span>`;

      const updateCountdown = () => {
        const nowMs = getNowMs();
        const diff = target - nowMs;
        if (diff <= 0) {
          countdownNode.innerHTML = `<span class="count-number">Joyeux Noël la Pokéfamily !</span>`;
          return;
        }
        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        countdownNode.innerHTML = `
          <span class="count-number">
            ${fmt(days, "j")} ${fmt(pad2(hours), "h")} ${fmt(pad2(minutes), "m")} ${fmt(pad2(seconds), "s")}
          </span>
          <span class="count-label">avant le Noël de la Pokéfamily</span>
        `;
      };

      updateCountdown();
      setInterval(updateCountdown, 1000);
    }

    const nextCountdownNode = document.querySelector("[data-next-countdown]");
    if (nextCountdownNode) {
      const now = new Date(getNowMs());
      let openDay = 0;
      if (now < start) {
        openDay = 0;
      } else if (now > end) {
        openDay = totalDays;
      } else {
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        openDay = Math.min(
          totalDays,
          Math.round((today.getTime() - start.getTime()) / 86_400_000) + 1,
        );
      }

      const nextDay = openDay < totalDays ? openDay + 1 : null;
      const nextTarget =
        nextDay !== null
          ? dateForDay(nextDay).getTime()
          : null;

      const formatLabel = (days, hours, minutes, seconds) => {
        const parts = [];
        if (days > 0) parts.push(`${days}j`);
        parts.push(`${pad2(hours)}h${pad2(minutes)}m${pad2(seconds)}s`);
        return parts.join(" ");
      };

      const updateNextCountdown = () => {
        if (nextTarget === null || nextDay === null) {
          nextCountdownNode.textContent = "Tous les paquets sont ouverts !";
          return;
        }
        const diff = nextTarget - getNowMs();
        if (diff <= 0) {
          nextCountdownNode.textContent = `Paquet numéro ${nextDay} prêt !`;
          return;
        }
        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        nextCountdownNode.textContent = `${formatLabel(
          days,
          hours,
          minutes,
          seconds,
        )} avant le paquet numéro ${nextDay}`;
      };

      updateNextCountdown();
      setInterval(updateNextCountdown, 1000);
    }
  </script>
</BaseLayout>
