---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Calendrier de l'avent",
  description = "Calendrier de l'avent",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c1416" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/advent-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/advent-icon-192.png" />
  </head>
  <body>
    <div class="christmas-lights" aria-hidden="true">
      {Array.from({ length: 18 }, (_, index) => <i data-light={index % 4}></i>)}
    </div>
    <div class="page-shell">
      <slot />
    </div>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { updateViaCache: "none" });
        });
      }
    </script>
  </body>
</html>
